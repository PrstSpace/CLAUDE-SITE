# --- Database ---
# Local dev / prisma migrate: full connection string.
# In docker-compose, only POSTGRES_* below are used (DATABASE_URL is built automatically).
DATABASE_URL="postgresql://prst:changeme@localhost:5432/prst_events?schema=public"
POSTGRES_USER=prst
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prst_events

# --- Admin session signing secret ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Microsoft Graph API (Azure AD app registration, client credentials flow) ---
# See README.md "Настройка Microsoft 365 / Azure AD" for step-by-step setup.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# Mailbox the app sends from, e.g. events@prst.space (must exist in the M365 tenant)
GRAPH_SENDER_MAILBOX=""
# Optional: internal mailbox BCC'd on every ticket email, as an independent
# record that the consent receipt (marketing opt-in included) reached the
# registrant's own inbox. Leave empty to disable.
CONSENT_RECEIPT_EMAIL=""

# --- Initial admin account (created by `npm run db:seed` / the `migrate` compose service) ---
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="PRST Admin"
